# Shell-compatible. Copy to .env, replace placeholders, then export as in README.
DJANGO_SECRET_KEY='replace-with-a-generated-secret'
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
PGDATABASE=biopay
PGUSER=biopay
PGPASSWORD='replace-with-your-local-database-password'
PGHOST=127.0.0.1
PGPORT=5432
# Disabled by default. Enable only on a private development machine.
BIOPAY_ENABLE_DEMO_API=false
BIOPAY_DEMO_TOKEN=''
BIOPAY_MAX_PAYMENT=100
# Used only by the seed/create commands; never printed. Minimum 12 characters.
BIOPAY_DEMO_PASSWORD=''
BIOPAY_NEW_PASSWORD=''
